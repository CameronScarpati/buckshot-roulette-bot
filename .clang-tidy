# A check set aimed at correctness and at costs that are easy to pay by
# accident. Style is settled by .clang-format, so checks that argue with it are
# left out on purpose. CI treats what remains as errors, so this file describes
# the code rather than contradicting it.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  misc-unused-parameters,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  readability-misleading-indentation,
  readability-redundant-control-flow

WarningsAsErrors: '*'
HeaderFilterRegex: '(engine|solver|cli)/.*'
